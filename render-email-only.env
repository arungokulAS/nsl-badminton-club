# Import this file in Render to add/update only registration-email related vars.
# Keep only keys that are NOT already present in Render Environment list.

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=replace_with_gmail_address@gmail.com
EMAIL_HOST_PASSWORD=replace_with_gmail_app_password_16_chars
DEFAULT_FROM_EMAIL=replace_with_gmail_address@gmail.com
EMAIL_TIMEOUT=8
REGISTRATION_CONFIRMATION_EMAIL_ENABLED=true
REGISTRATION_CONFIRMATION_EMAIL_ASYNC=false

# Optional (recommended on Render if SMTP is unreachable):
RESEND_API_KEY=replace_with_resend_api_key
RESEND_FROM_EMAIL=replace_with_verified_sender@yourdomain.com
